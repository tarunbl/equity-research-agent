# Anthropic (required)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Finnhub — real-time financial data (required)
# Free tier available at: https://finnhub.io
FINNHUB_API_KEY=

# SEC EDGAR user agent (required)
# SEC requires identification for API access. Format: "Your Name your@email.com"
# See: https://www.sec.gov/developer
SEC_USER_AGENT=Your Name your@email.com

# Hugging Face — FinBERT sentiment model (optional)
# Only needed if utils/finbert.py is used. Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=
